            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"{{campanhaTitulo}}\",\n  \"descricao\": \"Tentativa de duplicar o título\",\n  \"dataInicio\": \"{{$isoTimestamp}}\",\n  \"dataFim\": \"2026-12-31T00:00:00Z\",\n  \"metaFinanceira\": 1000,\n  \"imagem\": null\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Roda \"Criar Campanha\" antes deste request', function () {",
                  "    pm.expect(pm.collectionVariables.get('campanhaTitulo')).to.not.be.empty;",
                  "});",
                  "",
                  "pm.test('Status code é 400 (título já existe)', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
