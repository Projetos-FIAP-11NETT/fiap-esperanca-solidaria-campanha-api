            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"\",\n  \"descricao\": \"Descrição\",\n  \"dataInicio\": \"{{$isoTimestamp}}\",\n  \"dataFim\": \"2026-12-31T00:00:00Z\",\n  \"metaFinanceira\": 0,\n  \"imagem\": null\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code é 400', function () {",
