{
  "info": {
    "_postman_id": "b5a7f5b0-6e0a-4c3c-9c2e-campanha-api-0001",
    "name": "Campanha API - Conexão Solidária",
    "description": "Coleção de testes da campanha-api (CRUD restrito a GestorONG, painel público de transparência e cache Redis). Usa o header X-Dev-Role para simular autenticação enquanto a usuarios-api (emissora de tokens Firebase) não existe — só funciona em ambiente Development com Auth:DevBypassEnabled=true.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5054", "type": "string" },
    { "key": "campanhaId", "value": "", "type": "string" },
    { "key": "campanhaTitulo", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code é 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Painel Público",
      "item": [
        {
          "name": "Listar Campanhas Públicas",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/campanhas/publicas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "campanhas", "publicas"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code é 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Resposta é uma lista', function () {",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Obter Campanha Por Id",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/campanhas/{{campanhaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "campanhas", "{{campanhaId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code é 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Retorna a campanha correta', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.id).to.eql(pm.collectionVariables.get('campanhaId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Obter Campanha Por Id - Inexistente (404)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/campanhas/00000000-0000-0000-0000-000000000000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "campanhas", "00000000-0000-0000-0000-000000000000"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code é 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "CRUD (GestorONG)",
      "item": [
        {
          "name": "Criar Campanha",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Dev-Role", "value": "GestorONG" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/campanhas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "campanhas"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Campanha de Teste Postman\",\n  \"descricao\": \"Criada via coleção Postman\",\n  \"dataInicio\": \"{{$isoTimestamp}}\",\n  \"dataFim\": \"2026-12-31T00:00:00Z\",\n  \"metaFinanceira\": 5000,\n  \"imagem\": null\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code é 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Campanha criada como Ativa e sem arrecadação', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('Ativa');",
                  "    pm.expect(json.valorTotalArrecadado).to.eql(0);",
                  "    pm.collectionVariables.set('campanhaId', json.id);",
                  "    pm.collectionVariables.set('campanhaTitulo', json.titulo);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar Campanha - Payload Inválido (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Dev-Role", "value": "GestorONG" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/campanhas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "campanhas"]
