      ]
    },
    {
      "name": "Cache Redis",
      "item": [
        {
          "name": "1. Listar Públicas (popula o cache)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/campanhas/publicas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "campanhas", "publicas"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code é 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Contém a campanha criada', function () {",
                  "    var json = pm.response.json();",
                  "    var encontrada = json.some(function (c) { return c.id === pm.collectionVariables.get('campanhaId'); });",
                  "    pm.expect(encontrada).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Cancelar Campanha (deve invalidar o cache)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Dev-Role", "value": "GestorONG" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/campanhas/{{campanhaId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "campanhas", "{{campanhaId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Campanha de Teste Postman - Atualizada\",\n  \"descricao\": \"Cancelada para validar invalidação de cache\",\n  \"dataInicio\": \"{{$isoTimestamp}}\",\n  \"dataFim\": \"2026-12-31T00:00:00Z\",\n  \"metaFinanceira\": 8000,\n  \"imagem\": null,\n  \"status\": \"Cancelada\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code é 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Listar Públicas (confirma invalidação)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/campanhas/publicas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "campanhas", "publicas"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code é 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Campanha cancelada não aparece mais (cache não ficou stale)', function () {",
                  "    var json = pm.response.json();",
                  "    var encontrada = json.some(function (c) { return c.id === pm.collectionVariables.get('campanhaId'); });",
                  "    pm.expect(encontrada).to.be.false;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
