                  "    var json = pm.response.json();",
                  "    pm.expect(json.titulo).to.eql('Campanha de Teste Postman - Atualizada');",
                  "    pm.expect(json.metaFinanceira).to.eql(8000);",
                  "});"
                ]
              }
