            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Campanha de Teste Postman - Atualizada\",\n  \"descricao\": \"Atualizada via coleção Postman\",\n  \"dataInicio\": \"{{$isoTimestamp}}\",\n  \"dataFim\": \"2026-12-31T00:00:00Z\",\n  \"metaFinanceira\": 8000,\n  \"imagem\": null,\n  \"status\": \"Ativa\"\n}"
            }
          },
          "event": [
